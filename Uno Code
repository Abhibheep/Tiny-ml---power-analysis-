#include <Wire.h>
#include <Adafruit_INA219.h>

Adafruit_INA219 ina219;

void setup() {
    Serial.begin(115200);

    if (!ina219.begin()) {
        Serial.println("Error: INA219 not found!");
        while (1) {
            delay(10);
        }
    }

    Serial.println("INA219 Motor Data Collection Started");
    Serial.println("Current(mA),Voltage(V)");
}

void loop() {

    float current_mA = ina219.getCurrent_mA();
    float voltage_V = ina219.getBusVoltage_V();

    // Print data in CSV format
    Serial.print(current_mA, 3);
    Serial.print(",");
    Serial.println(voltage_V, 3);

    // Approximately 45 Hz sampling
    delay(22);
}
